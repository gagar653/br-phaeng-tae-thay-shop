name: Discord Meme Bot Auto Sender

on:
  schedule:
    # ตั้งเวลาเป็น UTC (ตัวอย่างตั้งไว้ 13:00 UTC ซึ่งตรงกับ 20:00 เวลาไทยทุกวัน)
    - cron: '0 13 * * *'
  workflow_dispatch: # ทำให้เราสามารถกดปุ่มรันด้วยมือในหน้า GitHub ได้ตลอดเวลา

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Run Discord Bot
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
        run: node bot.js
