<!-- ADMIN PANEL -->
<section id="adminPanel" style="display:none;padding:30px;background:#141414;border-radius:20px;margin:30px;">
    <h2 style="color:#ff2b2b">เพิ่มสินค้าใหม่</h2>

    <input id="name" placeholder="ชื่อสินค้า">
    <input id="price" placeholder="ราคา">
    <input id="colors" placeholder="สี เช่น ดำ,ขาว">
    <input id="sizes" placeholder="ไซส์ เช่น S,M,L,XL">

    <textarea id="detail" placeholder="รายละเอียดสินค้า"></textarea>

    <input type="file" id="images" multiple accept="image/*">

    <button onclick="uploadProduct()">อัปโหลดสินค้า</button>
</section>
